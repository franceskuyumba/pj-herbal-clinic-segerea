# ============================================
# PJHerbal Clinic — Environment Variables
# Copy to .env in apps/api and .env.local in apps/web as noted below.
# Never commit real values.
# ============================================

# ---------- Shared ----------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---------- Database (apps/api/.env) ----------
DATABASE_URL="postgresql://pjherbal:pjherbal_dev_password@localhost:5432/pjherbal_clinic?schema=public"
REDIS_URL="redis://localhost:6379"

# ---------- Firebase Authentication ----------
# Web (apps/web/.env.local) — public client config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# API (apps/api/.env) — Admin SDK service account (server-side only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------- Payments: Selcom ----------
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR_ID=
SELCOM_BASE_URL=https://apigw.selcommobile.com

# ---------- Payments: Flutterwave ----------
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# ---------- Payments: DPO (Direct Pay Online) ----------
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
DPO_BASE_URL=https://secure.3gdirectpay.com/API/v6/

# ---------- WhatsApp (Meta Cloud API) ----------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---------- Analytics / Tracking (apps/web/.env.local) ----------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ---------- Security ----------
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECRET=replace-with-a-long-random-string
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- Image storage / optimization ----------
# Cloudinary is assumed for product image hosting + on-the-fly optimization
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
