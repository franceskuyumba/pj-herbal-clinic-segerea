// ============================================================
// PJHerbal Clinic — Segerea Branch
// Full production data model (Phase 2)
// Every entity here traces back to a numbered section of the SRS —
// see PHASE-2-DATABASE-SCHEMA.md for the mapping.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------

enum Role {
  customer
  staff
  admin
}

enum ProductStatus {
  active
  out_of_stock
  discontinued
  draft
}

enum OrderStatus {
  pending
  paid
  processing
  dispatched
  delivered
  cancelled
}

enum PaymentMethod {
  mpesa
  tigopesa
  airtelmoney
  halopesa
  crdb_bank
  nmb_bank
}

enum PaymentProvider {
  selcom
  flutterwave
  dpo
}

enum PaymentStatus {
  initiated
  pending
  successful
  failed
  refunded
}

enum DeliveryStatus {
  unassigned
  assigned
  picked_up
  in_transit
  delivered
  failed
}

enum CampaignChannel {
  email
  whatsapp
}

enum CampaignStatus {
  draft
  scheduled
  sent
  cancelled
}

// ---------------------------------------------------------------
// USERS & ACCOUNTS  (SRS §9 Customer Account System, §17 Security)
// ---------------------------------------------------------------

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String   @unique
  phone       String?  @unique
  name        String?
  role        Role     @default(customer)

  // Granular admin capabilities beyond the base role, e.g.
  // ["orders:manage", "inventory:manage", "campaigns:manage"]
  // Used for SRS §17 "Admin role permissions".
  permissions String[] @default([])

  addresses   Address[]
  orders      Order[]
  reviews     Review[]
  wishlist    WishlistItem[]
  cart        Cart?
  deliveries  Delivery[]      @relation("CourierUser")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([role])
}

model Address {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  label      String?
  fullName   String
  phone      String
  region     String
  district   String
  streetLine String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------
// CATALOG  (SRS §3 Featured Categories, §4 Product Page)
// ---------------------------------------------------------------

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  imageUrl String?
  products Product[]
}

model Product {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  shortBenefits      String
  description        String
  ingredients        String
  usageInstructions  String
  benefits           String
  warnings           String

  priceCents         Int
  compareAtCents     Int?
  currency           String        @default("TZS")

  stock              Int           @default(0)
  lowStockThreshold  Int           @default(10)
  status             ProductStatus @default(active)

  category           Category      @relation(fields: [categoryId], references: [id])
  categoryId         String

  images             ProductImage[]
  reviews            Review[]
  orderItems         OrderItem[]
  cartItems          CartItem[]
  wishlistedBy       WishlistItem[]
  batches            ProductBatch[]
  inventoryLogs      InventoryLog[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([categoryId])
  @@index([status])
}

model ProductImage {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  altText   String?
  position  Int      @default(0)

  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@unique([productId, userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ---------------------------------------------------------------
// CART  (SRS §5 Shopping Cart, §14 abandoned-cart automation)
// ---------------------------------------------------------------

model Cart {
  id             String     @id @default(cuid())
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String     @unique
  items          CartItem[]
  couponCode     String?
  lastActivityAt DateTime   @updatedAt
  reminderSentAt DateTime?
}

model CartItem {
  id        String   @id @default(cuid())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Int

  @@unique([cartId, productId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  percentOff     Int?
  amountOffCents Int?
  minOrderCents  Int?
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  orders         Order[]
}

// ---------------------------------------------------------------
// ORDERS  (SRS §6 Checkout, §12 Order Management)
// ---------------------------------------------------------------

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  user             User        @relation(fields: [userId], references: [id])
  userId           String

  status           OrderStatus @default(pending)

  fullName         String
  phone            String
  email            String
  region           String
  district         String
  streetLine       String

  items            OrderItem[]
  subtotalCents    Int
  deliveryFeeCents Int         @default(0)
  discountCents    Int         @default(0)
  totalCents       Int

  coupon           Coupon?     @relation(fields: [couponId], references: [id])
  couponId         String?

  payment          Payment?
  delivery         Delivery?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id             String   @id @default(cuid())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  product        Product  @relation(fields: [productId], references: [id])
  productId      String
  productName    String
  unitPriceCents Int
  quantity       Int

  @@index([orderId])
}

// ---------------------------------------------------------------
// PAYMENTS  (SRS §7 Payment Integration)
// ---------------------------------------------------------------

model Payment {
  id          String          @id @default(cuid())
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String          @unique

  provider    PaymentProvider
  method      PaymentMethod
  status      PaymentStatus   @default(initiated)

  amountCents Int
  currency    String          @default("TZS")

  providerRef String?
  retryCount  Int             @default(0)

  logs        PaymentLog[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([providerRef])
}

model PaymentLog {
  id         String   @id @default(cuid())
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId  String
  event      String
  rawPayload Json?
  createdAt  DateTime @default(now())

  @@index([paymentId])
}

// ---------------------------------------------------------------
// DELIVERY  (SRS §13 Delivery System)
// ---------------------------------------------------------------

model Courier {
  id         String     @id @default(cuid())
  name       String
  phone      String
  isActive   Boolean    @default(true)
  deliveries Delivery[]
}

model Delivery {
  id            String         @id @default(cuid())
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String         @unique

  courier       Courier?       @relation(fields: [courierId], references: [id])
  courierId     String?

  courierUser   User?          @relation("CourierUser", fields: [courierUserId], references: [id])
  courierUserId String?

  status        DeliveryStatus @default(unassigned)
  feeCents      Int            @default(0)
  estimatedAt   DateTime?
  deliveredAt   DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ---------------------------------------------------------------
// INVENTORY  (SRS §11 Inventory Management)
// ---------------------------------------------------------------

model ProductBatch {
  id             String    @id @default(cuid())
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  batchCode      String
  quantity       Int
  manufacturedAt DateTime?
  expiresAt      DateTime?
  receivedAt     DateTime  @default(now())

  @@index([productId])
}

model InventoryLog {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  change    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([productId])
}

// ---------------------------------------------------------------
// CONTENT  (SRS §3 Health Blogs, §16 SEO, §10 Landing Pages Manager)
// ---------------------------------------------------------------

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String
  contentHtml     String
  coverImage      String?

  metaTitle       String?
  metaDescription String?

  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isPublished])
}

model LandingPage {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  contentJson     Json
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------
// MARKETING & WHATSAPP  (SRS §8 WhatsApp Integration, §14 Automation)
// ---------------------------------------------------------------

model PromoCampaign {
  id           String          @id @default(cuid())
  name         String
  channel      CampaignChannel
  status       CampaignStatus  @default(draft)
  message      String
  scheduledFor DateTime?
  sentAt       DateTime?
  createdAt    DateTime        @default(now())
}

model WhatsAppMessage {
  id             String   @id @default(cuid())
  toPhone        String
  templateName   String
  payload        Json?
  status         String
  relatedOrderId String?
  createdAt      DateTime @default(now())

  @@index([toPhone])
  @@index([relatedOrderId])
}
